
const products = {
  LS001: {
    sku: "LS001",
    name: "Lumière Milk Soap",
    price: 89
  },
  LS002: {
    sku: "LS002",
    name: "Lumière Aloe Soap",
    price: 99
  }
};

let cart = [];

function addCart(sku) {
  const product = products[sku];

  const found = cart.find(
    item => item.sku === sku
  );

  if (found) {
    found.quantity++;
  } else {
    cart.push({
      ...product,
      quantity: 1
    });
  }

  showCart();
}

function showCart() {
  const total = cart.reduce(
    (sum, item) =>
      sum + item.price * item.quantity,
    0
  );

  console.log("ตะกร้าสินค้า:", cart);
  console.log("ยอดรวม:", total);
}
